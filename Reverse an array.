#include <stdio.h>

int main()
{
    int n;
    printf("Enter the size of the array: ");
    scanf("%d",&n);
    
    int a[n];
    printf("Enter the elements in the array:\n");
    for(int i=0;i<n;i++)
        scanf("%d",&a[i]);
        
    printf("\nInput array:\n");
    for(int i=0;i<n;i++)
        printf(" %d",a[i]);
        
    printf("\nResultant array:\n");
    for(int i=n-1;i>=0;i--)
        printf(" %d",a[i]);
    
    
    return 0;
}
