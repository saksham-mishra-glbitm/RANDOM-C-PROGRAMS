#include <stdio.h>

int main()
{
    int n;
    printf("Enter the size of the array: ");
    scanf("%d",&n);
    
    int a[n];
    printf("Enter the elements in the array:\n");
    for(int i=0;i<n;i++)
        scanf("%d",&a[i]);
        
    printf("\nInput array:");
    for(int i=0;i<n;i++)
        printf(" %d",a[i]);
        
    int b[n];
    for(int i=0;i<n;i++)
    {
        b[i]=a[i];
    }
        
    printf("\nNew array:");
    for(int i=0;i<n;i++)
        printf(" %d",a[i]);
    
    return 0;
}
